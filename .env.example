# Postgres. Vercel: use the Neon/Vercel Postgres URL. VPS: your local Postgres.
DATABASE_URL=postgres://user:pass@host:5432/delasa
DB_SSL=                     # set to "require" on managed Postgres

# SMS gateway. console = log only (dev). kavenegar | smsir = real sending.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER=                 # the approved sender line
SMS_OTP_TEMPLATE=           # Kavenegar verify-lookup template name, if used

# Where new booking requests are announced
RECEPTION_PHONE=+98...

# Sign cookies with this. Generate: openssl rand -hex 32
SESSION_SECRET=

# Optional: enables the LLM-backed chat reply. Leave empty for the scripted bot.
ANTHROPIC_API_KEY=
