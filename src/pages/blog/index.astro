---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
import { clinic } from '../../data/clinic';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fa = new Intl.DateTimeFormat('fa-IR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={`مقالات | ${clinic.name}`} description="مطالب آموزشی دل‌آسا دربارهٔ رابطه، اضطراب، سلامت روان و روان‌درمانی.">
  <Header />

  <main id="main">
    <PageHead
      eyebrow="مقالات"
      title="روان‌شناسی، به زبان زندگی"
      lead="آنچه در اتاق درمان زیاد تکرار می‌شود، اینجا نوشته می‌شود."
    />

    <section class="section section-top-flush">
      <div class="wrap narrow">
        {
          posts.length === 0 ? (
            <p class="note">به‌زودی اولین مقاله منتشر می‌شود.</p>
          ) : (
            <ul class="post-list">
              {posts.map((post) => (
                <li class="reveal">
                  <a href={`/blog/${post.id}`}>
                    <time datetime={post.data.date.toISOString()}>{fa.format(post.data.date)}</time>
                    <h2>{post.data.title}</h2>
                    <p>{post.data.description}</p>
                    <span class="post-author">{post.data.author}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>
  </main>

  <Footer />
  <div class="sticky-cta"><a class="btn btn-primary" href="/booking">رزرو وقت</a></div>
</Base>
