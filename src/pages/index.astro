---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallToAction from '../components/CallToAction.astro';
import { Image } from 'astro:assets';
import mark from '../assets/brand/mark.png';
import { clinic, services, process, team } from '../data/clinic';
---

<Base>
  <Header />

  <main id="main">
    <section class="hero clinic-hero">
      <div class="wrap">
        <p class="hero-name reveal">{clinic.tagline}</p>
        <h1 class="reveal">جایی برای اینکه با خودت<br />روبه‌رو شوی.</h1>
        <p class="lead reveal">
          دل‌آسا مرکزی برای ارزیابی، روان‌درمانی و سلامت روان است. کار را با شناخت دقیق موضوع
          شروع می‌کنیم و بعد شما را به درمانگری می‌سپاریم که تخصصش با مسئلهٔ شما بیشترین تناسب را دارد.
        </p>
        <div class="hero-actions reveal">
          <a class="btn btn-primary" href="/contact">رزرو وقت ارزیابی</a>
          <a class="btn btn-ghost" href="/process">مسیر پذیرش چگونه است؟</a>
        </div>
      </div>

      <p class="hero-meta wrap">{clinic.city} · {clinic.hours}</p>
    </section>

    <section class="section section-soft" id="services">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow">خدمات</p>
          <h2>در دل‌آسا چه کاری انجام می‌شود؟</h2>
        </div>

        <ul class="service-list">
          {
            services.map((service, i) => (
              <li class="reveal">
                <a href={`/services/${service.slug}`}>
                  <span class="service-num">{`۰${(i + 1).toLocaleString('fa-IR')}`}</span>
                  <span class="service-name">{service.title}</span>
                  <span class="service-body">{service.short}</span>
                  <span class="service-arrow" aria-hidden="true">←</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section" id="process">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow">مسیر پذیرش</p>
          <h2>از اولین پیام تا جلسهٔ درمان</h2>
          <p class="lead">
            در هر مرحله می‌دانید کجای کار هستید. هیچ‌کس بدون ارزیابی وارد جلسهٔ درمان نمی‌شود.
          </p>
        </div>

        <ol class="steps steps-5">
          {
            process.map((step) => (
              <li class="reveal">
                <b>{step.num}. {step.title}</b>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>

        <p class="section-more reveal"><a href="/process">توضیح کامل هر مرحله ←</a></p>
      </div>
    </section>

    <section class="section section-sage" id="team">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow">همکاران</p>
          <h2>چه کسی شما را می‌بیند</h2>
          <p class="lead">
            هر درمانگر دل‌آسا رویکرد و حوزهٔ تخصصی خودش را دارد. ارجاع شما به یکی از آن‌ها
            بر اساس نتیجهٔ ارزیابی انجام می‌شود، نه بر اساس نوبت خالی.
          </p>
        </div>

        <ul class="team-list">
          {
            team.map((member) => (
              <li class="reveal">
                <a href={`/team/${member.slug}`}>
                  <b>{member.name}</b>
                  <span>{member.role}</span>
                  <p>{member.short}</p>
                </a>
              </li>
            ))
          }
        </ul>

        <p class="section-more reveal"><a href="/team">همهٔ همکاران ←</a></p>
      </div>
    </section>

    <section class="section logo-story">
      <div class="wrap narrow">
        <Image class="logo-story-mark reveal" src={mark} alt="" widths={[150, 300]} sizes="150px" aria-hidden="true" />
        <p class="eyebrow reveal">نام و نشان</p>
        <h2 class="reveal">چرا «دل‌آسا»؟</h2>
        <p class="reveal">
          «دل‌آسا» یعنی آنچه دل را آرام می‌کند. نشان کلینیک هم از همین ایده ساخته شده است:
          یک قلب که از دو پیکر شکل گرفته — یکی در آغوش دیگری. نه نجات‌دادن، نه نصیحت‌کردن؛
          فقط حضورِ کسی که کنارت می‌نشیند تا آنچه سخت است، تنها تجربه نشود.
        </p>
        <p class="reveal">
          رنگ خاکی و گرمِ نشان هم انتخاب شده تا فضای کلینیک را منتقل کند: آرام، انسانی،
          و دور از سردیِ فضاهای درمانی.
        </p>
      </div>
    </section>

    <CallToAction />
  </main>

  <Footer />

  <div class="sticky-cta">
    <a class="btn btn-primary" href="/contact">رزرو وقت</a>
  </div>
</Base>
