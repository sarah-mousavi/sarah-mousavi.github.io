---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHead from '../components/PageHead.astro';
import CallToAction from '../components/CallToAction.astro';
import { clinic } from '../data/clinic';
---

<Base title={`دربارهٔ ما | ${clinic.name}`} description="دل‌آسا چه مرکزی است، چه کاری می‌کند و هدفش چیست.">
  <Header />

  <main id="main">
    <PageHead eyebrow="دربارهٔ ما" title="ما کی هستیم" />

    <section class="section section-top-flush">
      <div class="wrap narrow">
        <div class="prose reveal">
          <!-- TODO: این متن پیش‌نویس است و باید با متن خودِ مجموعه جایگزین شود. -->
          <p>
            دل‌آسا مرکزی برای ارزیابی، روان‌درمانی و سلامت روان در {clinic.city} است. تیم ما از
            روان‌شناسان و روان‌درمانگرانی تشکیل شده که هر کدام در حوزه و رویکرد مشخصی کار می‌کنند:
            از روان‌درمانی فردی بزرگسال و زوج‌درمانی تا سکس‌تراپی و کار با کودک و نوجوان.
          </p>

          <h2>چه کار می‌کنیم</h2>
          <p>
            کار ما با ارزیابی شروع می‌شود، نه با درمان. پیش از هر چیز یک مصاحبهٔ بالینی و در صورت
            نیاز آزمون روان‌شناختی انجام می‌شود تا روشن شود موضوع دقیقاً چیست. بعد از آن، شما به
            درمانگری ارجاع داده می‌شوید که تخصص و رویکردش با مسئلهٔ شما بیشترین تناسب را دارد.
          </p>
          <p>
            این ترتیب تصادفی نیست. بخش بزرگی از شکست‌های درمان از آنجا می‌آید که آدم با مسئلهٔ
            اشتباه، پیش درمانگرِ اشتباه می‌نشیند و بعد نتیجه نمی‌گیرد.
          </p>

          <h2>هدف‌مان از اینجا بودن</h2>
          <p>
            می‌خواهیم رسیدن به کمک حرفه‌ای ساده، روشن و بدون شرم باشد. اینکه آدم بداند در چه
            مرحله‌ای است، چرا این مرحله لازم است، و چه انتظاری می‌تواند داشته باشد.
          </p>
          <p>
            و می‌خواهیم زبان روان‌شناسی از فضای تخصصی بیرون بیاید و به زبان زندگی روزمره نزدیک شود —
            چیزی که در مقالات و محتوای آموزشی‌مان هم دنبال می‌کنیم.
          </p>

          <h2>ساعت کار</h2>
          <p>{clinic.hours} — {clinic.address}</p>
        </div>
      </div>
    </section>

    <CallToAction />
  </main>

  <Footer />
  <div class="sticky-cta"><a class="btn btn-primary" href="/contact">رزرو وقت</a></div>
</Base>
