---
import { focusGroups } from '../data/site';
---

<section class="section section-sage" id="focus">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">حوزه‌های کاری</p>
      <h2>معمولاً با چه چیزهایی پیش من می‌آیند</h2>
    </div>

    <div class="focus-groups">
      {
        focusGroups.map((group) => (
          <section class="focus-group reveal">
            <h3>{group.title}</h3>
            <ul class="chips">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>
