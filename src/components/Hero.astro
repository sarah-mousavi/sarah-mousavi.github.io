---
import { Image } from 'astro:assets';
import portrait from '../assets/sara.jpg';
import { site } from '../data/site';
---

<section class="hero" id="hero">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="hero-name">{site.name}</p>

      <h1>با خودت روبه‌رو شو،<br />تا رابطه‌ات با زندگی تغییر کند.</h1>

      <p class="hero-role">
        روان‌درمانگر کودک و بزرگسال<br />
        <span>متخصص ISTDP</span>
      </p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="#contact">رزرو جلسه</a>
        <a class="btn btn-ghost" href="#approach">آشنایی با ISTDP</a>
      </div>
    </div>

    <figure class="hero-photo">
      <Image
        src={portrait}
        alt={`${site.name}، ${site.role}`}
        widths={[520, 760, 1080]}
        sizes="(max-width: 980px) 86vw, 520px"
        loading="eager"
      />
    </figure>
  </div>

  <p class="hero-meta wrap">{site.clinic}</p>
</section>
