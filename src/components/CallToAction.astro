---
import { clinic } from '../data/clinic';
const waHref = `https://wa.me/${clinic.phone.whatsapp}?text=${encodeURIComponent(clinic.whatsappText)}`;
---

<section class="booking-band">
  <div class="wrap">
    <div class="booking-head reveal">
      <h2>شاید لازم نیست همه‌چیز را تنهایی حل کنی.</h2>
      <p>برای شروع، یک گفت‌وگو کافی است. پذیرش دل‌آسا {clinic.hours} پاسخگوست.</p>
    </div>

    <div class="booking-actions reveal">
      <a class="btn btn-wa" href={waHref} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2m0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.23 8.23 0 0 1 0 16.47m4.52-6.16c-.25-.12-1.47-.72-1.69-.81s-.39-.12-.56.13-.64.81-.79.97-.29.19-.54.06a6.7 6.7 0 0 1-1.99-1.23 7.4 7.4 0 0 1-1.37-1.71c-.15-.25 0-.39.11-.51s.25-.29.37-.44a1.7 1.7 0 0 0 .25-.41.46.46 0 0 0 0-.44c-.06-.12-.56-1.35-.77-1.85s-.4-.42-.56-.43h-.48a.92.92 0 0 0-.66.31 2.78 2.78 0 0 0-.87 2.07 4.84 4.84 0 0 0 1.01 2.56 11 11 0 0 0 4.22 3.73 13 13 0 0 0 1.41.52 3.4 3.4 0 0 0 1.56.1 2.55 2.55 0 0 0 1.67-1.18 2.07 2.07 0 0 0 .14-1.18c-.06-.1-.22-.16-.47-.28"></path>
        </svg>
        رزرو وقت در واتس‌اپ
      </a>
      <a class="btn btn-tel" href={`tel:${clinic.phone.tel}`}><span dir="ltr">{clinic.phone.display}</span></a>
      <a class="btn btn-tel" href={clinic.telegram} target="_blank" rel="noopener">تلگرام</a>
    </div>
  </div>
</section>
