---
import { services } from '../data/site';
---

<section class="section" id="services">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">خدمات</p>
      <h2>جلسات چگونه برگزار می‌شوند؟</h2>
    </div>

    <div class="cards-4">
      {
        services.map((s, i) => (
          <article class="service reveal">
            <span class="service-index" aria-hidden="true">{`۰${(i + 1).toLocaleString('fa-IR')}`}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
