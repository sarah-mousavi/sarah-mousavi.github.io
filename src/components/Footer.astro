---
import { Image } from 'astro:assets';
import lockup from '../assets/brand/lockup.png';
import { clinic, nav, services } from '../data/clinic';

const year = new Date().getFullYear().toLocaleString('fa-IR', { useGrouping: false });
const waHref = `https://wa.me/${clinic.phone.whatsapp}?text=${encodeURIComponent(clinic.whatsappText)}`;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <Image src={lockup} alt={clinic.full} widths={[240, 480]} sizes="180px" />
        <p>{clinic.address}</p>
        <p>{clinic.hours}</p>
      </div>

      <nav class="footer-col" aria-label="خدمات">
        <h3>خدمات</h3>
        <ul>
          {services.map((s) => <li><a href={`/services/${s.slug}`}>{s.title}</a></li>)}
        </ul>
      </nav>

      <nav class="footer-col" aria-label="بخش‌های سایت">
        <h3>بخش‌ها</h3>
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer-col">
        <h3>تماس</h3>
        <ul>
          <li><a href={waHref} target="_blank" rel="noopener">واتس‌اپ</a></li>
          <li><a href={clinic.telegram} target="_blank" rel="noopener">تلگرام</a></li>
          <li><a href={clinic.instagram} target="_blank" rel="noopener">اینستاگرام</a></li>
          <li><a href={`tel:${clinic.phone.tel}`} dir="ltr">{clinic.phone.display}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-inner">
      <p>© {year} {clinic.full}</p>
      <p class="footer-note">محتوای این سایت جنبهٔ آموزشی دارد و جایگزین جلسهٔ درمان نیست.</p>
    </div>
  </div>
</footer>
