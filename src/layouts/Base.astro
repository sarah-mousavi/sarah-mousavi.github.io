---
import '../styles/global.css';
import { clinic } from '../data/clinic';

interface Props {
  title?: string;
  description?: string;
}

const { title = clinic.title, description = clinic.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://sarah-mousavi.github.io');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: clinic.full,
  alternateName: clinic.name,
  description: clinic.description,
  url: canonical.origin,
  telephone: clinic.phone.tel,
  medicalSpecialty: 'Psychiatric',
  address: {
    '@type': 'PostalAddress',
    addressLocality: clinic.city,
    addressCountry: 'IR',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '21:00',
  },
  areaServed: 'ایران',
};
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F3EC" />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.png`} type="image/png" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:site_name" content={clinic.full} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('og.jpg', canonical).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={`${import.meta.env.BASE_URL}fonts/Vazirmatn-400.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${import.meta.env.BASE_URL}fonts/Amiri-400.woff2`} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip-link" href="#main">رفتن به محتوای اصلی</a>
    <slot />
  </body>
</html>
